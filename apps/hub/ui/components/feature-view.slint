import { Screen } from "../contract/nav.slint";
import { Home } from "../screens/home.slint";
import { Weather } from "../screens/weather.slint";
import { FirstBoot } from "../screens/first-boot.slint";
import { Settings } from "../screens/settings.slint";
import { Calendar } from "../screens/calendar.slint";
import { Photos } from "../screens/photos.slint";
import { Countdowns } from "../screens/countdowns.slint";
import { Reminders } from "../screens/reminders.slint";
import { Timers } from "../screens/timers.slint";

// Nội dung của một màn tính năng theo `screen`. Shell dựng hai bản để fade chéo / giữ màn khi đóng.
export component FeatureView inherits Rectangle {
    in property <Screen> screen;

    if root.screen == Screen.home: Home { }
    if root.screen == Screen.weather: Weather { }
    if root.screen == Screen.settings: Settings { }
    if root.screen == Screen.reminders: Reminders { }
    if root.screen == Screen.timers: Timers { }
    if root.screen == Screen.photos: Photos { }
    if root.screen == Screen.calendar: Calendar { }
    if root.screen == Screen.countdowns: Countdowns { }
    if root.screen == Screen.first-boot: FirstBoot { }
}
