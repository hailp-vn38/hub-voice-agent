import { Screen } from "../contract/nav.slint";

// Nơi nút "‹" và vuốt về của màn tính năng quay lại: Menu, hoặc trung tâm nếu đến bằng đường tắt.
// Trạng thái trình bày: Shell ghi, màn tính năng đọc; màn đích vẫn do Nav.screen quyết.
export global BackNav {
    in-out property <Screen> origin: Screen.center;
}

// Điểm (toạ độ tuyệt đối) mà màn tính năng nở ra / thu về: ô Menu vừa chạm. Âm = chưa có, dùng giữa màn.
export global ZoomOrigin {
    in-out property <length> x: -1px;
    in-out property <length> y: -1px;
}
