import { Theme } from "../../theme.slint";
import { CalendarData } from "../../contract/calendar.slint";

// Dải 7 ngày: hôm nay → 6 ngày tới.
export component WeekStrip inherits Rectangle {
    height: 128px;
    for d[i] in CalendarData.week: Rectangle {
        private property <bool> sel: CalendarData.selected-day == d.key;
        x: i * (self.width + Theme.space-s);
        width: (parent.width - 6 * Theme.space-s) / 7;
        background: sel ? Theme.accent : Theme.card;
        border-radius: Theme.radius;
        animate background { duration: 200ms; }
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            Text { text: d.weekday; color: sel ? Theme.background : Theme.text-dim; font-size: Theme.font-small; horizontal-alignment: center; }
            Text { text: d.day; color: sel ? Theme.background : (d.today ? Theme.accent : Theme.text); font-size: Theme.font-title; horizontal-alignment: center; }
            HorizontalLayout {
                alignment: center;
                spacing: 6px;
                height: 10px;
                for k in min(d.dots, 3): Rectangle { width: 10px; height: 10px; border-radius: 5px; background: sel ? Theme.background : Theme.warm; }
            }
        }
        TouchArea { clicked => { CalendarData.select-day(d.key); } }
    }
}
