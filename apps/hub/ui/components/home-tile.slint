import { Theme } from "../theme.slint";
import { Icon } from "icon.slint";
import { HomeTile, HomeKind } from "../contract/home.slint";

// Thẻ thiết bị nhà thông minh, dùng chung màn Nhà và màn trung tâm.
export component HomeTileView inherits Rectangle {
    in property <HomeTile> tile;
    in property <string> updated;
    callback toggle(string);
    private property <bool> active: tile.on && tile.kind != HomeKind.sensor;
    private property <bool> tappable: tile.kind != HomeKind.sensor && !tile.pending;
    background: root.active ? Theme.warm : Theme.card;
    border-radius: Theme.radius;
    opacity: tile.stale ? 0.45 : 1.0;

    VerticalLayout {
        padding: Theme.space-m;
        spacing: Theme.space-s;
        Icon {
            name: root.tile.kind == HomeKind.sensor ? "sun" : "home";
            color: root.active ? Theme.background : Theme.text-dim;
            size: 48px;
        }
        Text {
            text: root.tile.name;
            color: root.active ? Theme.background : Theme.text;
            font-size: Theme.font-body;
            overflow: elide;
        }
        Text {
            text: root.tile.pending ? "Đang chờ…"
                : root.tile.stale ? "cập nhật lúc " + root.updated
                : root.tile.kind == HomeKind.sensor ? root.tile.value
                : root.tile.on ? "Bật" : "Tắt";
            color: root.tile.pending ? Theme.accent : root.active ? Theme.background : Theme.text-dim;
            font-size: Theme.font-small;
            overflow: elide;
        }
    }
    TouchArea {
        enabled: root.tappable;
        clicked => { root.toggle(root.tile.key); }
    }
}
