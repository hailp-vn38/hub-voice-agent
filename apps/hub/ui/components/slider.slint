import { Theme } from "../theme.slint";
import { SettingsData } from "../contract/settings.slint";

// Slider 0..1 (Aurora). Cử chỉ bắt đầu trên slider thuộc slider (khoá vuốt điều hướng).
export component Slider inherits Rectangle {
    in property <float> value;
    callback changed-to(float);
    private property <length> u: Theme.unit;
    private property <length> knob: 24 * root.u;
    height: 44 * root.u;
    min-width: 240 * root.u;
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 8 * root.u;
        border-radius: self.height / 2;
        background: Theme.border.with-alpha(0.7);
        Rectangle {
            x: 0;
            width: parent.width * clamp(root.value, 0, 1);
            border-radius: parent.border-radius;
            background: @linear-gradient(90deg, Theme.accent 0%, Theme.accent-cyan 100%);
        }
    }
    Rectangle {
        x: (root.width - self.width) * clamp(root.value, 0, 1);
        y: (parent.height - self.height) / 2;
        width: root.knob;
        height: root.knob;
        border-radius: self.height / 2;
        background: Theme.text;
        drop-shadow-blur: 8 * root.u;
        drop-shadow-color: Theme.accent-cyan.with-alpha(0.5);
    }
    TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { SettingsData.dragging = true; }
            if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) { SettingsData.dragging = false; }
        }
        moved => { if (self.pressed) { root.changed-to(clamp((self.mouse-x - root.knob / 2) / (root.width - root.knob), 0, 1)); } }
        clicked => { root.changed-to(clamp((self.mouse-x - root.knob / 2) / (root.width - root.knob), 0, 1)); }
    }
}
