import { Nav, Screen } from "../../contract/nav.slint";

component NavButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> active;
    in property <length> u: 1px;
    callback activated();

    border-radius: 17 * root.u;
    background: root.active ? @linear-gradient(135deg, #164bbaed 0%, #123675cc 100%) : #0b1b32c0;
    border-color: root.active ? #398fff : #5273a22c;
    border-width: 1 * root.u;
    drop-shadow-blur: root.active ? 14 * root.u : 0;
    drop-shadow-color: #398fff60;

    Image {
        y: 16 * root.u;
        width: 30 * root.u;
        height: 30 * root.u;
        source: root.icon;
        colorize: root.active ? #f4f9ff : #93abc7;
    }
    Text {
        y: 54 * root.u;
        width: parent.width - 4 * root.u;
        height: 24 * root.u;
        text: root.label;
        color: root.active ? #ffffff : #b6c4dc;
        font-size: 12 * root.u;
        font-weight: root.active ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    TouchArea { clicked => { root.activated(); } }
}

// Sidebar trái: Home (trung tâm), Thiết bị (màn Nhà), Thống kê (menu tính năng), Cài đặt.
export component NavRail inherits Rectangle {
    in property <length> u: 1px;
    in property <Screen> current;
    width: 100 * root.u;
    background: #06172cbd;
    border-color: #6386c02d;
    border-width: 1 * root.u;
    border-radius: 24 * root.u;

    VerticalLayout {
        padding-top: 27 * root.u;
        padding-left: 17 * root.u;
        padding-right: 17 * root.u;
        spacing: 16 * root.u;
        alignment: start;
        NavButton {
            height: 90 * root.u;
            u: root.u;
            icon: @image-url("../../../assets/home/icons/home.png");
            label: "Home";
            active: root.current == Screen.center;
            activated => { Nav.navigate(Screen.center); }
        }
        NavButton {
            height: 90 * root.u;
            u: root.u;
            icon: @image-url("../../../assets/home/icons/devices.png");
            label: "Thiết bị";
            active: root.current == Screen.home;
            activated => { Nav.navigate(Screen.home); }
        }
        NavButton {
            height: 90 * root.u;
            u: root.u;
            icon: @image-url("../../../assets/home/icons/chart.png");
            label: "Thống kê";
            active: root.current == Screen.menu;
            activated => { Nav.navigate(Screen.menu); }
        }
        NavButton {
            height: 90 * root.u;
            u: root.u;
            icon: @image-url("../../../assets/home/icons/settings.png");
            label: "Cài đặt";
            active: root.current == Screen.settings;
            activated => { Nav.navigate(Screen.settings); }
        }
    }
}
