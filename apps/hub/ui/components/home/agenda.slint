import { Center } from "../../contract/center.slint";

component GlassCard inherits Rectangle {
    in property <length> u: 1px;
    in property <bool> zoomed;
    callback tapped();
    border-radius: 24 * root.u;
    border-width: 1 * root.u;
    transform-scale: root.zoomed ? 1.04 : 1.0;
    animate transform-scale { duration: 350ms; easing: ease-out; }
    TouchArea { clicked => { root.tapped(); } }
    @children
}

// "Lịch hôm nay": tối đa 3 sự kiện trên trục dọc; sự kiện đang diễn ra tô cam.
export component AgendaCard inherits GlassCard {
    background: @linear-gradient(135deg, #1c3158ed 0%, #15243ce9 100%);
    border-color: #a6c3ff70;
    private property <int> n: min(3, Center.today.length);

    Image {
        x: 21 * root.u;
        y: 20 * root.u;
        width: 31 * root.u;
        height: 31 * root.u;
        source: @image-url("../../../assets/home/icons/calendar.png");
        colorize: #9fc6ff;
    }
    Text {
        x: 61 * root.u;
        y: 20 * root.u;
        height: 31 * root.u;
        text: "Lịch hôm nay";
        font-size: 18 * root.u;
        font-weight: 600;
        color: #f5f8ff;
        vertical-alignment: center;
    }
    Text {
        x: parent.width - self.width - 20 * root.u;
        y: 20 * root.u;
        height: 31 * root.u;
        text: "Xem thêm  →";
        font-size: 12 * root.u;
        color: #bdcfe8;
        vertical-alignment: center;
    }
    if root.n == 0: Text {
        x: 26 * root.u;
        y: 75 * root.u;
        text: "Hôm nay không có lịch";
        font-size: 14 * root.u;
        color: #b7c9e4;
    }
    // Trục thời gian.
    if root.n > 1: Rectangle {
        x: 26 * root.u;
        y: 81 * root.u;
        width: 2 * root.u;
        height: (root.n - 1) * 36 * root.u;
        background: #476494;
    }
    for e[i] in Center.today: Rectangle {
        visible: i < 3;
        x: 21 * root.u;
        y: (67 + i * 36) * root.u;
        width: parent.width - 41 * root.u;
        height: 28 * root.u;
        Rectangle {
            x: (i == 0 ? 0 : 2) * root.u;
            width: (i == 0 ? 12 : 8) * root.u;
            height: self.width;
            border-radius: self.width / 2;
            background: i == 0 ? #72a8ff : #c4d8f8;
        }
        if e.now: Rectangle {
            x: 25 * root.u;
            width: 160 * root.u;
            border-radius: 8 * root.u;
            background: #ffb43f1f;
        }
        Text {
            x: 34 * root.u;
            width: 58 * root.u;
            height: parent.height;
            text: e.time;
            color: e.now ? #ffb43f : #e3edfc;
            font-size: 15 * root.u;
            font-weight: e.now ? 600 : 400;
            vertical-alignment: center;
        }
        Text {
            x: 100 * root.u;
            width: parent.width - self.x;
            height: parent.height;
            text: e.title;
            color: e.now ? #ffb43f : #edf4ff;
            font-size: 15 * root.u;
            font-weight: e.now ? 600 : 400;
            overflow: elide;
            vertical-alignment: center;
        }
    }
}

// "Tiếp theo": 2 Reminder sắp tới.
export component NextCard inherits GlassCard {
    background: #122238ee;
    border-color: #6e90c256;
    border-radius: 23 * root.u;

    Image {
        x: 22 * root.u;
        y: 23 * root.u;
        width: 30 * root.u;
        height: 30 * root.u;
        source: @image-url("../../../assets/home/icons/sparkle.png");
        colorize: #72aeff;
    }
    Text {
        x: 63 * root.u;
        y: 23 * root.u;
        height: 30 * root.u;
        text: "Tiếp theo";
        font-size: 15 * root.u;
        font-weight: 600;
        color: #ffffff;
        vertical-alignment: center;
    }
    if Center.reminders.length == 0: Text {
        x: 177 * root.u;
        y: 23 * root.u;
        height: 30 * root.u;
        text: "Không có nhắc nhở";
        font-size: 14 * root.u;
        color: #b7c9e4;
        vertical-alignment: center;
    }
    for r[i] in Center.reminders: Rectangle {
        visible: i < 2;
        x: 177 * root.u;
        y: (23 + i * 39) * root.u;
        width: parent.width - self.x - 16 * root.u;
        height: 30 * root.u;
        Image {
            x: 0;
            width: 22 * root.u;
            height: 22 * root.u;
            source: @image-url("../../../assets/home/icons/timer.png");
            colorize: #a3d4ff;
        }
        Text {
            x: 30 * root.u;
            width: parent.width - self.x;
            height: parent.height;
            text: r.time + "  " + r.text;
            font-size: 15 * root.u;
            color: #e3edfc;
            overflow: elide;
            vertical-alignment: center;
        }
    }
}
