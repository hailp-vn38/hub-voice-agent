import { Theme } from "../../theme.slint";
import { Center } from "../../contract/center.slint";

// Thẻ kính (Aurora GlassCard): chạm co nhẹ, phóng lớn khi `zoomed`.
component GlassCard inherits Rectangle {
    in property <length> u: 1px;
    in property <bool> zoomed;
    callback tapped();
    border-radius: Theme.radius-card;
    border-width: 1 * root.u;
    border-color: Theme.border;
    background: Theme.glass;
    transform-scale: root.zoomed ? 1.04 : touch.pressed ? 0.98 : 1.0;
    animate transform-scale { duration: touch.pressed ? Theme.anim-tap : Theme.anim-state; easing: ease-out; }
    touch := TouchArea { clicked => { root.tapped(); } }
    @children
}

// "Lịch hôm nay" (Aurora ScheduleCard): tối đa 3 sự kiện trên trục dọc;
// sự kiện đang diễn ra có nền cam + chữ đậm, không chỉ đổi màu.
export component AgendaCard inherits GlassCard {
    private property <int> n: min(3, Center.today.length);

    Image {
        x: 21 * root.u;
        y: 20 * root.u;
        width: 28 * root.u;
        height: 28 * root.u;
        source: @image-url("../../../assets/home/icons/calendar.png");
        colorize: Theme.accent-cyan;
    }
    Text {
        x: 59 * root.u;
        y: 20 * root.u;
        height: 28 * root.u;
        text: "Lịch hôm nay";
        font-size: Theme.type-section;
        font-weight: 600;
        color: Theme.text;
        vertical-alignment: center;
    }
    Text {
        x: parent.width - self.width - 20 * root.u;
        y: 20 * root.u;
        height: 28 * root.u;
        text: "Xem thêm  →";
        font-size: Theme.type-caption;
        color: Theme.text-dim;
        vertical-alignment: center;
    }
    if root.n == 0: Text {
        x: 26 * root.u;
        y: 75 * root.u;
        text: "Hôm nay không có lịch";
        font-size: Theme.type-body;
        color: Theme.text-dim;
    }
    // Trục thời gian.
    if root.n > 1: Rectangle {
        x: 26 * root.u;
        y: 81 * root.u;
        width: 2 * root.u;
        height: (root.n - 1) * 36 * root.u;
        background: Theme.border;
    }
    for e[i] in Center.today: Rectangle {
        visible: i < 3;
        x: 21 * root.u;
        y: (67 + i * 36) * root.u;
        width: parent.width - 41 * root.u;
        height: 28 * root.u;
        Rectangle {
            x: (i == 0 ? 0 : 2) * root.u;
            width: (i == 0 ? 12 : 8) * root.u;
            height: self.width;
            border-radius: self.width / 2;
            background: i == 0 ? Theme.accent : Theme.text-dim;
        }
        if e.now: Rectangle {
            x: 25 * root.u;
            width: 160 * root.u;
            border-radius: 8 * root.u;
            background: Theme.warm.with-alpha(0.14);
        }
        Text {
            x: 34 * root.u;
            width: 58 * root.u;
            height: parent.height;
            text: e.time;
            color: e.now ? Theme.warm : Theme.text;
            font-size: Theme.type-body;
            font-weight: e.now ? 600 : 400;
            vertical-alignment: center;
        }
        Text {
            x: 100 * root.u;
            width: parent.width - self.x;
            height: parent.height;
            text: e.title;
            color: e.now ? Theme.warm : Theme.text;
            font-size: Theme.type-body;
            font-weight: e.now ? 600 : 400;
            overflow: elide;
            vertical-alignment: center;
        }
    }
}

// "Tiếp theo" (Aurora ScheduleCard): 2 Reminder sắp tới.
export component NextCard inherits GlassCard {
    Image {
        x: 22 * root.u;
        y: 23 * root.u;
        width: 28 * root.u;
        height: 28 * root.u;
        source: @image-url("../../../assets/home/icons/sparkle.png");
        colorize: Theme.accent-cyan;
    }
    Text {
        x: 61 * root.u;
        y: 23 * root.u;
        height: 28 * root.u;
        text: "Tiếp theo";
        font-size: Theme.type-card-title;
        font-weight: 600;
        color: Theme.text;
        vertical-alignment: center;
    }
    if Center.reminders.length == 0: Text {
        x: 177 * root.u;
        y: 23 * root.u;
        height: 28 * root.u;
        text: "Không có nhắc nhở";
        font-size: Theme.type-body;
        color: Theme.text-dim;
        vertical-alignment: center;
    }
    for r[i] in Center.reminders: Rectangle {
        visible: i < 2;
        x: 177 * root.u;
        y: (23 + i * 39) * root.u;
        width: parent.width - self.x - 16 * root.u;
        height: 30 * root.u;
        Image {
            x: 0;
            width: 22 * root.u;
            height: 22 * root.u;
            source: @image-url("../../../assets/home/icons/timer.png");
            colorize: Theme.accent-cyan;
        }
        Text {
            x: 30 * root.u;
            width: parent.width - self.x;
            height: parent.height;
            text: r.time + "  " + r.text;
            font-size: Theme.type-body;
            color: Theme.text;
            overflow: elide;
            vertical-alignment: center;
        }
    }
}
