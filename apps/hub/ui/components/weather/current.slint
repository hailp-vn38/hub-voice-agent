import { Theme } from "../../theme.slint";
import { Icon } from "../icon.slint";
import { WeatherNow } from "../../contract/weather.slint";

component Stat inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    Text { text: root.label; color: Theme.text-dim; font-size: Theme.font-small * 0.8; overflow: elide; }
    Text { text: root.value; color: Theme.text; font-size: Theme.font-small; overflow: elide; }
}

// Cột trái: thời tiết hiện tại.
export component CurrentColumn inherits Rectangle {
    in property <WeatherNow> now;
    in property <bool> aqi-lit;
    background: #00000040;
    border-radius: Theme.radius;
    clip: true;
    VerticalLayout {
        padding: Theme.space-m;
        spacing: Theme.space-s;
        HorizontalLayout {
            spacing: Theme.space-m;
            alignment: start;
            Icon { name: root.now.icon; size: 96px; color: Theme.warm; }
            Text { text: root.now.temp; color: Theme.text; font-size: 112px * Theme.text-scale; vertical-alignment: center; }
        }
        Text { text: root.now.summary; color: Theme.text; font-size: Theme.font-body; overflow: elide; }
        GridLayout {
            spacing: Theme.space-s;
            Row {
                Stat { label: "Cảm giác như"; value: root.now.feels; }
                Stat { label: "Độ ẩm"; value: root.now.humidity; }
            }
            Row {
                Stat { label: "Gió"; value: root.now.wind; }
                Stat { label: "UV"; value: root.now.uv; }
            }
        }
        Rectangle {
            height: 72px * Theme.text-scale;
            background: root.aqi-lit ? #ffffff30 : transparent;
            border-radius: 12px;
            animate background { duration: 300ms; }
            HorizontalLayout {
                spacing: Theme.space-s;
                Rectangle { width: 16px; height: 16px; y: (parent.height - 16px) / 2; border-radius: 8px; background: root.now.aqi-color; }
                Stat { label: "AQI " + root.now.aqi; value: root.now.aqi-level; }
            }
        }
        Stat { label: "Mọc · Lặn"; value: root.now.sunrise + " · " + root.now.sunset; }
    }
}
