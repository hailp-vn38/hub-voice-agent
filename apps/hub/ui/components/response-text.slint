import { Theme } from "../theme.slint";
import { Voice, VoiceState } from "../contract/voice.slint";
import { Response, Speaker } from "../contract/response.slint";

component WordView inherits Rectangle {
    in property <string> text;
    in property <bool> emphasis;
    in property <bool> partial; // từ cuối khi đang nghe: chưa chốt, để mờ
    in property <bool> fresh; // chỉ vài từ mới nhất mới sáng dần
    in property <length> font-size;
    in property <bool> revealed: true; // chưa tới lượt: rộng 0, ẩn
    private property <duration> t0: animation-tick();
    changed revealed => { root.t0 = animation-tick(); }
    // Từ mới hiện ở màu mờ rồi sáng dần lên màu chữ (kiểu karaoke).
    private property <float> p: root.fresh ? clamp((animation-tick() - root.t0) / 350ms, 0, 1) : 1;
    min-width: root.revealed ? label.preferred-width : 0px;
    max-width: self.min-width;
    visible: root.revealed;
    label := Text {
        y: (parent.height - self.height) / 2;
        text: root.text + " ";
        font-size: root.font-size;
        font-weight: root.emphasis ? 600 : 400;
        color: root.partial ? Theme.text-dim : Theme.text-dim.mix(Theme.text, 1 - root.p);
    }
}

// Dòng chữ phản hồi trong phụ đề Voice: chạy từ trái sang phải, không xuống dòng;
// khi tràn, cả hàng trượt sang trái, từ cũ mờ ở mép trái.
export component ResponseText inherits Rectangle {
    in property <length> font-size: Theme.font-title;
    clip: true;
    private property <duration> line-t: animation-tick();
    private property <int> serial: Response.line-serial;
    changed serial => { root.line-t = animation-tick(); }
    // Nhịp hiện từ cố định: 170 ms/từ.
    private property <int> shown: min(Response.words.length, floor((animation-tick() - root.line-t) / 170ms) + 1);
    // Bề rộng hàng chữ đang hiện, để phụ đề co theo.
    out property <length> text-width: row.preferred-width;

    // Hàng chữ: bắt đầu ở mép trái; tràn thì trượt trái để từ mới nhất luôn thấy.
    Rectangle {
        opacity: Response.fading ? 0 : 1;
        animate opacity { duration: 1500ms; easing: ease-in; }
        row := HorizontalLayout {
            x: min(0px, parent.width - self.preferred-width);
            height: parent.height;
            alignment: start;
            animate x { duration: 200ms; easing: ease-out; }
            for w[i] in Response.words: WordView {
                // Mép trái mờ dần: từ trôi ra gần mép thì nhạt đi (nền trong suốt, không phủ gradient).
                opacity: row.x < 0 ? clamp((row.x + self.x) / 160px, 0, 1) : 1;
                revealed: i < root.shown;
                text: w.text;
                emphasis: w.emphasis;
                partial: Response.speaker == Speaker.user && Voice.state == VoiceState.listening && i == root.shown - 1;
                fresh: i >= root.shown - 3;
                font-size: root.font-size;
            }
        }
    }
}
