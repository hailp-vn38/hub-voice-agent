import { Theme } from "../theme.slint";

// Card của màn trung tâm: chạm để mở màn tính năng, phóng lớn tại chỗ khi `zoomed`.
export component CenterCardBox inherits Rectangle {
    in property <bool> zoomed;
    callback tapped();
    background: Theme.card;
    border-radius: Theme.radius;
    clip: true;
    transform-scale: root.zoomed ? 1.06 : 1.0;
    animate transform-scale { duration: 350ms; easing: ease-out; }
    TouchArea { clicked => { root.tapped(); } }
    @children
}
