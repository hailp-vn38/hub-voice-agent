import { Theme } from "../theme.slint";
import { StatusBar } from "../contract/status.slint";

// Thanh trạng thái mép trên: giờ bên trái; Wi-Fi, Bluetooth, điện thoại, badge offline bên phải.
export component StatusBarView inherits Rectangle {
    private property <length> u: Theme.unit;
    height: Theme.frame-top * root.u;
    Text {
        x: Theme.pad-len;
        height: parent.height;
        text: StatusBar.time;
        color: Theme.text-dim;
        font-size: Theme.type-body;
        vertical-alignment: center;
    }
    HorizontalLayout {
        x: parent.width - self.width - Theme.pad-len;
        height: parent.height;
        spacing: 16 * root.u;
        alignment: end;
        if StatusBar.offline: Rectangle {
            width: label.preferred-width + 16 * root.u;
            height: 20 * root.u;
            y: (parent.height - self.height) / 2;
            border-radius: self.height / 2;
            background: Theme.warm;
            label := Text {
                text: "Offline";
                color: Theme.background;
                font-size: Theme.type-caption;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Image {
            y: (parent.height - self.height) / 2;
            width: 18 * root.u;
            height: 18 * root.u;
            source: @image-url("../../assets/home/icons/wifi.png");
            colorize: StatusBar.offline || StatusBar.wifi-strength == 0 ? Theme.error : Theme.text-dim;
            opacity: StatusBar.wifi-strength >= 2 || StatusBar.offline ? 1 : 0.6;
        }
        Image {
            y: (parent.height - self.height) / 2;
            width: 18 * root.u;
            height: 18 * root.u;
            source: @image-url("../../assets/home/icons/bluetooth.png");
            colorize: Theme.text-dim;
        }
        Image {
            y: (parent.height - self.height) / 2;
            width: 14 * root.u;
            height: 18 * root.u;
            source: @image-url("../../assets/home/icons/phone.png");
            colorize: Theme.text-dim;
        }
    }
}
