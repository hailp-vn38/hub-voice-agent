import { Theme } from "../theme.slint";
import { AlertData, AlertKind } from "../contract/alert.slint";
import { Voice, VoiceState, VoiceLevels } from "../contract/voice.slint";

// Hình học Voice dock: tâm Orb (toạ độ cửa sổ, điểm xuất phát ticket 06) và chiều cao hàng dock.
export global Dock {
    in-out property <length> orb-x;
    in-out property <length> orb-y;
    // Chiều cao hàng Voice ở đáy (Shell ghi theo cỡ cửa sổ).
    in-out property <length> height: 240px;
}

// Nút mic ở đầu thanh Voice (thiết kế smart-hub-home): viên gradient xanh–tím,
// icon mic + 3 vạch sóng theo mức âm. Giữ mọi trạng thái của Orb cũ.
export component Orb inherits Rectangle {
    // Xám và không chạm được (vd. lần đầu khởi động, voice chưa cấu hình).
    in property <bool> disabled;
    // Đơn vị thiết kế (1 px của canvas 1280×600).
    in property <length> u: 1px;
    width: 60 * root.u;
    height: 44 * root.u;
    private property <duration> now: animation-tick();
    private property <int> wake: Voice.wake-serial;
    private property <int> tool: Voice.tool-serial;
    private property <int> err: Voice.error-serial;
    private property <duration> wake-t: -10000ms;
    private property <duration> tool-t: -10000ms;
    private property <duration> err-t: -10000ms;
    changed wake => { root.wake-t = animation-tick(); }
    changed tool => { root.tool-t = animation-tick(); }
    changed err => { root.err-t = animation-tick(); }

    private property <bool> grey: root.disabled || Voice.state == VoiceState.offline || Voice.mic-muted;
    private property <float> level: Voice.state == VoiceState.listening ? VoiceLevels.mic
        : Voice.state == VoiceState.speaking ? VoiceLevels.tts : 0;
    private property <bool> active: Voice.state != VoiceState.idle && Voice.state != VoiceState.offline;
    private property <float> breath: sin(root.now / 4000ms * 1turn);
    private property <float> wp: clamp((root.now - root.wake-t) / 700ms, 0, 1);
    private property <float> tp: clamp((root.now - root.tool-t) / 600ms, 0, 1);
    private property <float> ep: clamp((root.now - root.err-t) / 450ms, 0, 1);
    private property <bool> thinking: Voice.state == VoiceState.thinking;

    // Sóng lan khi wake.
    Rectangle {
        border-radius: Theme.radius-s;
        border-width: 2 * root.u;
        border-color: Theme.accent-cyan;
        opacity: root.wp < 1 ? 1 - root.wp : 0;
        transform-scale: 1 + root.wp * 0.6;
    }
    // Quầng sáng theo tiếng nói.
    Rectangle {
        border-radius: Theme.radius-s;
        background: Theme.accent;
        opacity: root.active ? 0.2 + 0.3 * root.level : 0;
        transform-scale: 1.1 + 0.35 * root.level;
        animate opacity { duration: 150ms; }
    }
    // Lõi (rung ngang một lần khi có lỗi).
    Rectangle {
        x: sin(root.ep * 3turn) * 8 * root.u * (1 - root.ep);
        border-radius: Theme.radius-s;
        border-width: 1 * root.u;
        border-color: root.grey ? Theme.border : Theme.accent.brighter(0.4);
        background: root.grey ? Theme.card
            : @linear-gradient(125deg, Theme.accent 0%, Theme.accent-cyan.mix(Theme.accent, 0.3) 100%);
        opacity: AlertData.kind != AlertKind.none ? 0.7 + 0.3 * sin(root.now / 1200ms * 1turn)
            : root.active ? 1 : 0.9 + 0.1 * root.breath;
        Image {
            x: 10 * root.u;
            y: (parent.height - self.height) / 2;
            width: 24 * root.u;
            height: 24 * root.u;
            source: @image-url("../../assets/home/icons/mic.png");
            colorize: Theme.text;
        }
        // 3 vạch sóng: theo mức âm; nhấp lần lượt khi đang nghĩ.
        for i in 3: Rectangle {
            x: (38 + i * 6) * root.u;
            width: 3 * root.u;
            height: (6 + 14 * (root.thinking ? 0.5 + 0.5 * sin(root.now / 600ms * 1turn - i * 0.25turn)
                : root.active ? root.level * (i == 1 ? 1 : 0.7) : 0.15)) * root.u;
            y: (parent.height - self.height) / 2;
            border-radius: 1.5 * root.u;
            background: Theme.text;
            opacity: root.grey ? 0.4 : 0.9;
        }
        // Tắt mic: gạch chéo.
        Rectangle {
            width: 34 * root.u;
            height: 3 * root.u;
            background: Theme.text;
            opacity: Voice.mic-muted ? 1 : 0;
            transform-rotation: -35deg;
            animate opacity { duration: 200ms; }
        }
    }
    // Hạt bắn lên khi tool chạy.
    Rectangle {
        width: 10 * root.u;
        height: 10 * root.u;
        border-radius: 5 * root.u;
        background: Theme.warm;
        opacity: root.tp < 1 ? 1 - root.tp : 0;
        y: (parent.height - self.height) / 2 - root.tp * 120 * root.u;
    }

    TouchArea {
        enabled: !root.disabled;
        width: max(parent.width, Theme.touch-min);
        height: max(parent.height, Theme.touch-min);
        clicked => { Voice.orb-tapped(); }
    }

    private property <length> ax: self.absolute-position.x;
    private property <length> ay: self.absolute-position.y;
    function anchor() {
        Dock.orb-x = root.absolute-position.x + root.width / 2;
        Dock.orb-y = root.absolute-position.y + root.height / 2;
    }
    init => { root.anchor(); }
    changed ax => { root.anchor(); }
    changed ay => { root.anchor(); }
}
