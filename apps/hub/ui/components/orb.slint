import { Theme } from "../theme.slint";
import { AlertData, AlertKind } from "../contract/alert.slint";
import { Voice, VoiceState, VoiceLevels } from "../contract/voice.slint";

// Hình học Voice: tâm Orb (toạ độ cửa sổ, điểm xuất phát ticket 06) và chiều cao chừa ở đáy
// cho thẻ nổi, overlay báo.
export global Dock {
    in-out property <length> orb-x;
    in-out property <length> orb-y;
    in-out property <length> height: 240px;
}

// Orb Voice: lõi tròn + viền blob dao động theo VoiceLevels, cung xoay khi nghĩ,
// vòng nét đứt khi mất kết nối, vòng hổ phách khi tắt mic. Vẽ trong viewbox 40×40.
export component Orb inherits Rectangle {
    in property <bool> disabled;
    in property <length> u: 1px;
    width: 52 * root.u;
    height: self.width;
    // Chỉ đọc animation-tick() khi có hiệu ứng (nghe/nói/nghĩ, xung wake/tool/lỗi, alert);
    // đứng yên thì giữ `rest` để không có binding nào xin vẽ lại khung hình.
    private property <bool> pulsing;
    private property <bool> active: root.listening || root.speaking || root.thinking || root.pulsing || AlertData.kind != AlertKind.none;
    private property <duration> rest;
    private property <duration> now: root.active ? animation-tick() : root.rest;
    changed active => { if (!root.active) { root.rest = animation-tick(); } }
    pulse-end := Timer {
        interval: 750ms;
        running: false;
        triggered => { root.pulsing = false; self.running = false; }
    }
    private property <float> t: root.now / 1000ms;
    private property <int> wake: Voice.wake-serial;
    private property <int> tool: Voice.tool-serial;
    private property <int> err: Voice.error-serial;
    private property <duration> wake-t: -10000ms;
    private property <duration> tool-t: -10000ms;
    private property <duration> err-t: -10000ms;
    changed wake => { root.wake-t = animation-tick(); root.pulsing = true; pulse-end.running = false; pulse-end.running = true; }
    changed tool => { root.tool-t = animation-tick(); root.pulsing = true; pulse-end.running = false; pulse-end.running = true; }
    changed err => { root.err-t = animation-tick(); root.pulsing = true; pulse-end.running = false; pulse-end.running = true; }
    private property <float> wp: clamp((root.now - root.wake-t) / 700ms, 0, 1);
    private property <float> tp: clamp((root.now - root.tool-t) / 600ms, 0, 1);
    private property <float> ep: clamp((root.now - root.err-t) / 450ms, 0, 1);

    private property <VoiceState> st: Voice.state;
    private property <bool> muted: Voice.mic-muted && root.st != VoiceState.offline;
    private property <bool> off: root.disabled || root.st == VoiceState.offline;
    private property <bool> listening: !root.off && !root.muted && root.st == VoiceState.listening;
    private property <bool> speaking: !root.off && !root.muted && root.st == VoiceState.speaking;
    private property <bool> thinking: !root.off && !root.muted && root.st == VoiceState.thinking;
    private property <bool> idle: !root.listening && !root.speaking && !root.thinking && !root.off && !root.muted;
    private property <float> level: root.listening ? VoiceLevels.mic : root.speaking ? VoiceLevels.tts : 0;
    private property <float> lv: root.level;
    animate lv { duration: 90ms; }
    private property <float> breath: 0.5;

    // Blob: 4 điểm quanh tâm, bán kính lệch theo hai sóng sin, nối bằng cubic gần tròn.
    private property <float> br: root.speaking ? 13 + root.lv * 2 : 14 + root.lv * 3;
    private property <float> ba: root.speaking ? 0.6 + root.lv * 2.2 : 0.6 + root.lv * 3;
    private property <float> r0: root.br + root.ba * sin(root.t * 3 * 1rad);
    private property <float> r1: root.br + root.ba * sin((root.t * 4 + 1.7) * 1rad);
    private property <float> r2: root.br + root.ba * sin((root.t * 3.5 + 3.1) * 1rad);
    private property <float> r3: root.br + root.ba * sin((root.t * 4.5 + 4.6) * 1rad);
    private property <float> k: 0.5523;
    // Cung xoay khi nghĩ.
    private property <angle> arc-a: root.now / 1600ms * 1turn;

    // Sóng lan khi wake.
    Rectangle {
        border-radius: self.width / 2;
        border-width: 1.5 * root.u;
        border-color: Theme.accent-cyan;
        opacity: root.wp < 1 ? 1 - root.wp : 0;
        transform-scale: 0.6 + root.wp * 0.8;
    }

    // Vòng nền mờ (chờ, nghĩ) / hổ phách (tắt mic).
    Rectangle {
        width: 30 / 40 * parent.width;
        height: self.width;
        border-radius: self.width / 2;
        border-width: 1.5 * root.u;
        border-color: root.muted ? Theme.warm.with-alpha(0.55) : root.thinking ? Theme.accent-cyan.with-alpha(0.18) : Theme.text-dim.with-alpha(0.16);
        opacity: root.idle || root.thinking || root.muted ? 1 : 0;
        animate opacity { duration: Theme.anim-state; }
    }

    // Viền blob khi nghe / nói.
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 40;
        viewbox-height: 40;
        stroke: root.speaking ? Theme.text.with-alpha(0.5) : Theme.accent-cyan.with-alpha(0.5);
        stroke-width: 1.5 * root.u;
        opacity: root.listening || root.speaking ? 1 : 0;
        animate opacity { duration: Theme.anim-state; }
        commands: "M \{20 + root.r0} 20 C \{20 + root.r0} \{20 + root.k * root.r1} \{20 + root.k * root.r0} \{20 + root.r1} 20 \{20 + root.r1} C \{20 - root.k * root.r2} \{20 + root.r1} \{20 - root.r2} \{20 + root.k * root.r1} \{20 - root.r2} 20 C \{20 - root.r2} \{20 - root.k * root.r3} \{20 - root.k * root.r2} \{20 - root.r3} 20 \{20 - root.r3} C \{20 + root.k * root.r0} \{20 - root.r3} \{20 + root.r0} \{20 - root.k * root.r3} \{20 + root.r0} 20 Z";
    }

    // Cung xoay khi nghĩ.
    if root.thinking: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 40;
        viewbox-height: 40;
        stroke: Theme.accent-cyan;
        stroke-width: 2 * root.u;
        commands: "M \{20 + 15 * cos(root.arc-a)} \{20 + 15 * sin(root.arc-a)} A 15 15 0 0 1 \{20 + 15 * cos(root.arc-a + 95deg)} \{20 + 15 * sin(root.arc-a + 95deg)}";
    }

    // Mất kết nối: vòng nét đứt đỏ + gạch chéo.
    if root.off && !root.disabled: Rectangle {
        for i in 10: Path {
            width: 100%;
            height: 100%;
            viewbox-width: 40;
            viewbox-height: 40;
            stroke: Theme.error.with-alpha(0.75);
            stroke-width: 1.5 * root.u;
            commands: "M \{20 + 14 * cos(i * 36deg)} \{20 + 14 * sin(i * 36deg)} A 14 14 0 0 1 \{20 + 14 * cos(i * 36deg + 20deg)} \{20 + 14 * sin(i * 36deg + 20deg)}";
        }
        Rectangle {
            width: 20 / 40 * parent.width;
            height: 1.5 * root.u;
            background: Theme.error.with-alpha(0.8);
            transform-rotation: -45deg;
        }
    }

    // Lõi (rung ngang một lần khi có lỗi).
    Rectangle {
        x: (parent.width - self.width) / 2 + sin(root.ep * 3turn) * 6 * root.u * (1 - root.ep);
        width: (root.listening ? 16 + root.lv * 5 : root.speaking ? 13 + root.lv * 4 : root.thinking ? 10 : root.idle || root.disabled ? 8 + root.breath * 2 : 0) * root.u;
        height: self.width;
        border-radius: self.width / 2;
        animate width { duration: 120ms; easing: ease-out; }
        background: root.listening ? @linear-gradient(135deg, Theme.accent-cyan 0%, Theme.accent 100%)
            : root.speaking ? Theme.text.mix(Theme.accent-cyan, 0.85)
            : root.thinking ? Theme.accent-cyan.with-alpha(0.45)
            : Theme.text-dim.with-alpha(0.35 + 0.3 * root.breath);
        opacity: AlertData.kind != AlertKind.none ? 0.6 + 0.4 * sin(root.now / 1200ms * 1turn) : 1;
    }

    // Tắt mic: icon mic gạch.
    if root.muted: Rectangle {
        Image {
            width: 16 * root.u;
            height: 16 * root.u;
            source: @image-url("../../assets/home/icons/mic.png");
            colorize: Theme.warm;
        }
        Rectangle {
            width: 20 * root.u;
            height: 1.5 * root.u;
            background: Theme.warm;
            transform-rotation: -45deg;
        }
    }

    // Hạt bắn lên khi tool chạy.
    Rectangle {
        width: 6 * root.u;
        height: 6 * root.u;
        border-radius: 3 * root.u;
        background: Theme.warm;
        opacity: root.tp < 1 ? 1 - root.tp : 0;
        y: (parent.height - self.height) / 2 - root.tp * 90 * root.u;
    }

    private property <length> ax: self.absolute-position.x;
    private property <length> ay: self.absolute-position.y;
    function anchor() {
        Dock.orb-x = root.absolute-position.x + root.width / 2;
        Dock.orb-y = root.absolute-position.y + root.height / 2;
    }
    init => { root.anchor(); }
    changed ax => { root.anchor(); }
    changed ay => { root.anchor(); }
}
