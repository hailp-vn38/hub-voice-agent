// Bảng mẫu theme (Demo panel): bậc chữ, màu, icon.
import { Theme } from "../theme.slint";
import { Icon } from "../components/icon.slint";

component Swatch inherits Rectangle {
    in property <string> label;
    in property <color> fill;
    width: 150px;
    height: 80px;
    background: root.fill;
    border-radius: Theme.radius;
    Text { text: root.label; color: #000000; font-size: Theme.font-small; }
}

export component Sample inherits Rectangle {
    background: Theme.background;
    VerticalLayout {
        padding: Theme.space-l;
        spacing: Theme.space-s;
        Text { text: "21:45"; color: Theme.text; font-size: Theme.font-hero; font-weight: 600; }
        Text { text: "Hẹn giờ luộc trứng 7 phút · Thứ Bảy"; color: Theme.text; font-size: Theme.font-title; font-weight: 600; }
        Text { text: "Hẹn giờ luộc trứng 7 phút · Thứ Bảy"; color: Theme.text; font-size: Theme.font-body; }
        Text { text: "Hẹn giờ luộc trứng 7 phút · Thứ Bảy"; color: Theme.text-dim; font-size: Theme.font-small; }
        HorizontalLayout {
            spacing: Theme.space-s;
            Swatch { label: "card"; fill: Theme.card; }
            Swatch { label: "text"; fill: Theme.text; }
            Swatch { label: "text-dim"; fill: Theme.text-dim; }
            Swatch { label: "accent"; fill: Theme.accent; }
            Swatch { label: "warm"; fill: Theme.warm; }
            Swatch { label: "error"; fill: Theme.error; }
            Swatch { label: "done"; fill: Theme.done; }
        }
        HorizontalLayout {
            spacing: Theme.space-m;
            alignment: start;
            for n in ["sun", "cloud", "clock", "calendar", "home", "alarm", "settings", "microphone", "photo", "bell"]: Icon { name: n; color: Theme.accent; }
        }
    }
}
