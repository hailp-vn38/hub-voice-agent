import { Theme } from "../theme.slint";
import { Nav, Screen } from "../contract/nav.slint";
import { Countdown, CountdownUnit, CountdownsData } from "../contract/countdowns.slint";
import { Card } from "../components/card.slint";
import { SpawnIn } from "../components/spawn.slint";
import { Confetti } from "../components/confetti.slint";
import { ActionButton } from "../components/action-button.slint";

global CdFmt {
    pure public function show-value(c: Countdown) -> string {
        return c.unit == CountdownUnit.days ? c.value + " ngày"
            : c.unit == CountdownUnit.live ? c.value
            : c.unit == CountdownUnit.today ? "Hôm nay là " + c.label
            : "Đã qua";
    }

    pure public function value-color(c: Countdown) -> color {
        return c.unit == CountdownUnit.live ? Theme.warm : c.unit == CountdownUnit.passed ? Theme.text-dim : Theme.text;
    }
}

// Số ngày: khi `text` đổi (cùng mốc) thì số cũ trượt xuống, số mới trượt vào từ trên.
component FlipText inherits Rectangle {
    in property <string> text;
    in property <string> key;
    in property <length> font-size;
    in property <color> text-color;
    in property <bool> flip-enabled: true;
    private property <string> cur: root.text;
    private property <string> prev;
    private property <string> cur-key: root.key;
    private property <duration> now: animation-tick();
    private property <duration> t0: -10000ms;
    private property <float> p: clamp((root.now - root.t0) / 450ms, 0, 1);
    clip: true;
    changed text => {
        if (root.key == root.cur-key && root.flip-enabled) {
            root.prev = root.cur;
            root.t0 = animation-tick();
        }
        root.cur = root.text;
        root.cur-key = root.key;
    }
    Text {
        y: (root.p - 1) * root.height;
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.text-color;
        font-size: root.font-size;
        horizontal-alignment: left;
        vertical-alignment: center;
    }
    if root.p < 1: Text {
        y: root.p * root.height;
        width: parent.width;
        height: parent.height;
        text: root.prev;
        color: root.text-color;
        font-size: root.font-size;
        opacity: 1 - root.p;
        horizontal-alignment: left;
        vertical-alignment: center;
    }
}

// Viền sáng ngắn khi trợ lý trả lời "còn bao nhiêu ngày đến …" (focus).
component FocusPulse inherits Rectangle {
    in property <string> key;
    private property <int> serial: CountdownsData.focus-serial;
    private property <duration> now: animation-tick();
    private property <duration> t0: -10000ms;
    private property <float> p: clamp((root.now - root.t0) / 1500ms, 0, 1);
    changed serial => { if (CountdownsData.focus == root.key) { root.t0 = animation-tick(); } }
    border-radius: Theme.radius;
    border-width: 4px;
    border-color: Theme.accent;
    opacity: 1 - root.p;
    visible: root.p < 1;
}

export component Countdowns inherits Rectangle {
    private property <length> row-h: 150px;
    VerticalLayout {
        padding: Theme.space-l;
        spacing: Theme.space-m;
        Rectangle {
            height: Theme.touch-min;
            Text {
                text: "‹ " + CountdownsData.title;
                color: Theme.text;
                font-size: Theme.font-title;
                horizontal-alignment: left;
                vertical-alignment: center;
            }
            TouchArea { width: 480px; x: 0; clicked => { Nav.navigate(Screen.menu); } }
        }
        if !CountdownsData.has-main: Text {
            text: "Hey Jarvis, đếm ngược đến Tết";
            color: Theme.text-dim;
            font-size: Theme.font-body;
            horizontal-alignment: center;
            vertical-alignment: center;
            vertical-stretch: 1;
        }
        if CountdownsData.has-main: HorizontalLayout {
            spacing: Theme.space-l;
            vertical-stretch: 1;
            SpawnIn {
                key: CountdownsData.main.key;
                horizontal-stretch: 3;
                Card {
                    VerticalLayout {
                        padding: Theme.space-l;
                        spacing: Theme.space-m;
                        Text { text: CountdownsData.main.label; color: Theme.text-dim; font-size: Theme.font-title; }
                        FlipText {
                            key: CountdownsData.main.key;
                            text: CdFmt.show-value(CountdownsData.main);
                            text-color: CdFmt.value-color(CountdownsData.main);
                            font-size: Theme.font-hero;
                            flip-enabled: CountdownsData.main.unit == CountdownUnit.days;
                            vertical-stretch: 1;
                        }
                        Text {
                            text: CountdownsData.main.target + (CountdownsData.main.lunar != "" ? " · " + CountdownsData.main.lunar : "");
                            color: Theme.text;
                            font-size: Theme.font-body;
                        }
                        Rectangle {
                            height: 16px;
                            border-radius: 8px;
                            background: Theme.background;
                            Rectangle {
                                x: 0;
                                width: parent.width * clamp(CountdownsData.main.progress, 0, 1);
                                border-radius: 8px;
                                background: Theme.accent;
                            }
                        }
                        Text { text: CountdownsData.main.progress-text; color: Theme.text-dim; font-size: Theme.font-small; }
                    }
                    FocusPulse { key: CountdownsData.main.key; }
                    TouchArea { clicked => { CountdownsData.open-detail(); } }
                }
            }
            Rectangle {
                horizontal-stretch: 2;
                for c[i] in CountdownsData.others: Rectangle {
                    y: i * (root.row-h + Theme.space-m);
                    height: root.row-h;
                    width: parent.width;
                    animate y { duration: 350ms; easing: ease-out; }
                    SpawnIn {
                        key: c.key;
                        Card {
                            HorizontalLayout {
                                padding: Theme.space-m;
                                spacing: Theme.space-m;
                                VerticalLayout {
                                    alignment: center;
                                    Text { text: c.label; color: Theme.text; font-size: Theme.font-body; overflow: elide; }
                                    Text {
                                        text: c.target + (c.repeat-text != "" ? " · " + c.repeat-text : "");
                                        color: Theme.text-dim;
                                        font-size: Theme.font-small;
                                        overflow: elide;
                                    }
                                }
                                Text {
                                    text: CdFmt.show-value(c);
                                    color: CdFmt.value-color(c);
                                    font-size: Theme.font-body;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                            }
                            FocusPulse { key: c.key; }
                            TouchArea { clicked => { CountdownsData.select(c.key); } }
                        }
                    }
                }
            }
        }
        Rectangle { height: 240px; } // chừa Voice dock
    }
    if CountdownsData.detail-open && CountdownsData.has-main: Rectangle {
        background: #000000a0;
        TouchArea { clicked => { CountdownsData.close-detail(); } }
        Card {
            width: 800px;
            height: 420px;
            VerticalLayout {
                padding: Theme.space-l;
                spacing: Theme.space-m;
                Text { text: CountdownsData.main.label; color: Theme.text; font-size: Theme.font-title; }
                Text {
                    text: CountdownsData.main.target + (CountdownsData.main.lunar != "" ? " · " + CountdownsData.main.lunar : "")
                        + (CountdownsData.main.repeat-text != "" ? " · " + CountdownsData.main.repeat-text : "");
                    color: Theme.text-dim;
                    font-size: Theme.font-body;
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: Theme.space-m;
                    ActionButton { text: "Đóng"; clicked => { CountdownsData.close-detail(); } }
                    ActionButton { text: "Xoá"; danger: true; clicked => { CountdownsData.remove(CountdownsData.main.key); } }
                }
            }
        }
    }
    Confetti { serial: CountdownsData.confetti-serial; }
}
