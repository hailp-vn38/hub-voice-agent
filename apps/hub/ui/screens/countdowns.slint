import { Theme } from "../theme.slint";
import { Countdown, CountdownUnit, CountdownsData } from "../contract/countdowns.slint";
import { Backdrop } from "../components/home/backdrop.slint";
import { SpawnIn } from "../components/spawn.slint";
import { Confetti } from "../components/confetti.slint";
import { ActionButton } from "../components/action-button.slint";

global CdFmt {
    pure public function show-value(c: Countdown) -> string {
        return c.unit == CountdownUnit.days ? c.value + " ngày"
            : c.unit == CountdownUnit.live ? c.value
            : c.unit == CountdownUnit.today ? "Hôm nay là " + c.label
            : "Đã qua";
    }

    pure public function value-color(c: Countdown) -> color {
        return c.unit == CountdownUnit.live ? Theme.warm : c.unit == CountdownUnit.passed ? Theme.text-dim : Theme.text;
    }
}

// Số ngày: khi số giảm (cùng mốc) thì số cũ trượt xuống, số mới trượt vào từ trên.
component FlipText inherits Rectangle {
    in property <string> text;
    in property <float> num; // giá trị số của `text`, chỉ để biết chiều đổi
    in property <string> key;
    in property <length> font-size;
    in property <color> text-color;
    in property <bool> flip-enabled: true;
    private property <string> cur: root.text;
    private property <string> prev;
    private property <string> cur-key: root.key;
    private property <float> cur-num: root.num;
    private property <duration> now: animation-tick();
    private property <duration> t0: -10000ms;
    private property <float> p: clamp((root.now - root.t0) / 450ms, 0, 1);
    clip: true;
    changed text => {
        if (root.key == root.cur-key && root.flip-enabled && root.num < root.cur-num) {
            root.prev = root.cur;
            root.t0 = animation-tick();
        }
        root.cur = root.text;
        root.cur-key = root.key;
        root.cur-num = root.num;
    }
    Text {
        y: (root.p - 1) * root.height;
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.text-color;
        font-size: root.font-size;
        horizontal-alignment: left;
        vertical-alignment: center;
    }
    if root.p < 1: Text {
        y: root.p * root.height;
        width: parent.width;
        height: parent.height;
        text: root.prev;
        color: root.text-color;
        font-size: root.font-size;
        opacity: 1 - root.p;
        horizontal-alignment: left;
        vertical-alignment: center;
    }
}

// Viền sáng ngắn khi trợ lý trả lời "còn bao nhiêu ngày đến …" (focus).
component FocusPulse inherits Rectangle {
    in property <string> key;
    private property <int> serial: CountdownsData.focus-serial;
    private property <duration> now: animation-tick();
    private property <duration> t0: -10000ms;
    private property <float> p: clamp((root.now - root.t0) / 1500ms, 0, 1);
    changed serial => { if (CountdownsData.focus == root.key) { root.t0 = animation-tick(); } }
    border-radius: Theme.radius-panel;
    border-width: 2 * Theme.unit;
    border-color: Theme.accent;
    opacity: 1 - root.p;
    visible: root.p < 1;
}

export component Countdowns inherits Rectangle {
    private property <length> u: Theme.unit;
    private property <float> cw: self.width / root.u;
    private property <float> ch: self.height / root.u;
    private property <float> left: Theme.content-left;
    private property <float> right: root.cw - Theme.pad;
    private property <float> top: Theme.content-top;
    private property <float> bottom: root.ch - Theme.pad;
    private property <float> main-w: (root.right - root.left - Theme.pad) * 0.57;
    private property <duration> now: animation-tick();
    private property <duration> promote-t0: -10000ms;
    private property <length> from-x;
    private property <length> from-y;
    private property <float> q: clamp((root.now - root.promote-t0) / 400ms, 0, 1);
    private property <float> qe: 1 - (1 - root.q) * (1 - root.q);

    Backdrop { dim: 0.35; }

    Text {
        x: root.left * root.u;
        y: Theme.frame-top * root.u;
        width: (root.right - root.left) * root.u;
        height: 40 * root.u;
        text: CountdownsData.title;
        color: Theme.text;
        font-size: Theme.type-page-title;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
    }

    if !CountdownsData.has-main: Rectangle {
        x: root.left * root.u;
        y: root.top * root.u;
        width: (root.right - root.left) * root.u;
        height: (root.bottom - root.top) * root.u;
        border-radius: Theme.radius-panel;
        background: Theme.glass;
        border-width: 1 * root.u;
        border-color: Theme.border;
        VerticalLayout {
            alignment: center;
            spacing: 12 * root.u;
            Image { height: min(160 * root.u, parent.height * 0.5); source: @image-url("../../assets/home/mascot/assistant.png"); image-fit: contain; }
            Text { text: "Chưa có mốc đếm ngược"; color: Theme.text; font-size: Theme.type-section; font-weight: 600; horizontal-alignment: center; }
            Text { text: "Thử nói: “Hey Jarvis, đếm ngược đến Tết”"; color: Theme.text-dim; font-size: Theme.type-body; horizontal-alignment: center; wrap: word-wrap; }
        }
    }

    if CountdownsData.has-main: SpawnIn {
        x: root.left * root.u;
        y: root.top * root.u;
        width: root.main-w * root.u;
        height: (root.bottom - root.top) * root.u;
        key: CountdownsData.main.key;
        opacity: CountdownsData.main.fading ? 0 : 1;
        animate opacity { duration: 400ms; easing: ease-out; }
        Rectangle {
            x: root.from-x * (1 - root.qe);
            y: root.from-y * (1 - root.qe);
            transform-scale: 0.5 + 0.5 * root.qe;
            border-radius: Theme.radius-panel;
            background: @linear-gradient(135deg, Theme.accent.darker(0.55) 0%, Theme.glass 100%);
            border-width: 1 * root.u;
            border-color: Theme.accent.with-alpha(0.65);
            VerticalLayout {
                padding: Theme.pad-len;
                spacing: 12 * root.u;
                Text { text: "MỐC ĐẾM NGƯỢC"; color: Theme.accent-cyan; font-size: Theme.type-caption; font-weight: 600; }
                Text { text: CountdownsData.main.label; color: Theme.text; font-size: Theme.type-section; font-weight: 600; overflow: elide; }
                FlipText {
                    key: CountdownsData.main.key;
                    num: CountdownsData.main.value.to-float();
                    text: CdFmt.show-value(CountdownsData.main);
                    text-color: CdFmt.value-color(CountdownsData.main);
                    font-size: CountdownsData.main.unit == CountdownUnit.today ? Theme.type-page-title : Theme.type-clock;
                    flip-enabled: CountdownsData.main.unit == CountdownUnit.days;
                    vertical-stretch: 1;
                }
                Text {
                    text: CountdownsData.main.target + (CountdownsData.main.lunar != "" ? " · " + CountdownsData.main.lunar : "");
                    color: Theme.text; font-size: Theme.type-body; overflow: elide;
                }
                Rectangle {
                    height: 8 * root.u;
                    border-radius: self.height / 2;
                    background: Theme.background.with-alpha(0.65);
                    Rectangle { x: 0; width: parent.width * clamp(CountdownsData.main.progress, 0, 1); border-radius: parent.border-radius; background: Theme.accent-cyan; }
                }
                Text { text: CountdownsData.main.progress-text; color: Theme.text-dim; font-size: Theme.type-caption; }
            }
            FocusPulse { key: CountdownsData.main.key; }
            TouchArea { clicked => { CountdownsData.open-detail(); } }
        }
    }

    if CountdownsData.has-main: Rectangle {
        x: (root.left + root.main-w + Theme.pad) * root.u;
        y: root.top * root.u;
        width: (root.right - root.left - root.main-w - Theme.pad) * root.u;
        height: (root.bottom - root.top) * root.u;
        border-radius: Theme.radius-panel;
        background: Theme.glass;
        border-width: 1 * root.u;
        border-color: Theme.border;
        clip: true;
        VerticalLayout {
            padding: Theme.pad-len;
            spacing: 12 * root.u;
            Text { text: "Các mốc khác"; color: Theme.text; font-size: Theme.type-card-title; font-weight: 600; }
            if CountdownsData.others.length == 0: Text {
                text: "Các mốc tiếp theo sẽ xuất hiện ở đây"; color: Theme.text-dim; font-size: Theme.type-body; wrap: word-wrap; vertical-stretch: 1;
            }
            if CountdownsData.others.length > 0: Flickable {
                vertical-stretch: 1;
                content-height: rows.preferred-height;
                rows := VerticalLayout {
                    spacing: 8 * root.u;
                    for c in CountdownsData.others: SpawnIn {
                        height: 78 * root.u;
                        key: c.key;
                        opacity: c.fading ? 0 : 1;
                        animate opacity { duration: 400ms; easing: ease-out; }
                        Rectangle {
                            border-radius: Theme.radius-s;
                            background: touch.pressed ? Theme.card : Theme.card.with-alpha(0.6);
                            border-width: 1 * root.u;
                            border-color: Theme.border.with-alpha(0.6);
                            HorizontalLayout {
                                padding: 14 * root.u;
                                spacing: 12 * root.u;
                                VerticalLayout {
                                    spacing: 4 * root.u;
                                    alignment: center;
                                    Text { text: c.label; color: Theme.text; font-size: Theme.type-body; font-weight: 600; overflow: elide; }
                                    Text { text: c.target + (c.repeat-text != "" ? " · " + c.repeat-text : ""); color: Theme.text-dim; font-size: Theme.type-caption; overflow: elide; }
                                }
                                Text { text: CdFmt.show-value(c); color: CdFmt.value-color(c); font-size: Theme.type-body; horizontal-alignment: TextHorizontalAlignment.right; vertical-alignment: center; overflow: elide; }
                            }
                            FocusPulse { key: c.key; }
                            touch := TouchArea {
                                clicked => {
                                    root.from-x = self.absolute-position.x - root.absolute-position.x - root.left * root.u;
                                    root.from-y = self.absolute-position.y - root.absolute-position.y - root.top * root.u;
                                    root.promote-t0 = animation-tick();
                                    CountdownsData.select(c.key);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if CountdownsData.detail-open && CountdownsData.has-main: Rectangle {
        background: Theme.background.with-alpha(0.75);
        TouchArea { clicked => { CountdownsData.close-detail(); } }
        Rectangle {
            width: min(520 * root.u, root.width - 64 * root.u);
            height: min(260 * root.u, root.height - 64 * root.u);
            border-radius: Theme.radius-panel;
            background: Theme.card;
            border-width: 1 * root.u;
            border-color: Theme.border;
            VerticalLayout {
                padding: 24 * root.u;
                spacing: 12 * root.u;
                Text { text: CountdownsData.main.label; color: Theme.text; font-size: Theme.type-section; font-weight: 600; overflow: elide; }
                Text {
                    text: CountdownsData.main.target + (CountdownsData.main.lunar != "" ? " · " + CountdownsData.main.lunar : "")
                        + (CountdownsData.main.repeat-text != "" ? " · " + CountdownsData.main.repeat-text : "");
                    color: Theme.text-dim; font-size: Theme.type-body; wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 12 * root.u;
                    ActionButton { text: "Đóng"; clicked => { CountdownsData.close-detail(); } }
                    ActionButton { text: "Xoá"; danger: true; clicked => { CountdownsData.remove(CountdownsData.main.key); } }
                }
            }
        }
    }
    Confetti { serial: CountdownsData.confetti-serial; }
}
