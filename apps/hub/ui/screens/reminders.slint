import { Theme } from "../theme.slint";
import { Screen } from "../contract/nav.slint";
import { RemindersData } from "../contract/reminders.slint";
import { Backdrop } from "../components/home/backdrop.slint";
import { NavRail } from "../components/home/nav-rail.slint";
import { ItemRow, PastCard } from "../components/reminders/rows.slint";

// Màn Lời nhắc (Aurora): cột trái là thẻ "Kế tiếp" nổi bật (cam ấm) + "Đã nhắc gần đây";
// cột phải là thẻ kính liệt kê lời nhắc theo nhóm ngày. Toạ độ theo canvas 1280×600 nhân Theme.unit.
export component Reminders inherits Rectangle {
    private property <length> u: Theme.unit;
    private property <float> cw: self.width / root.u;
    private property <float> ch: self.height / root.u;
    private property <float> left: 130;
    private property <float> right: root.cw - 30;
    private property <float> top: 96;
    private property <float> bottom: root.ch - 92;
    private property <float> lcol: (root.right - root.left) * 0.36;
    private property <bool> empty: !RemindersData.has-next && RemindersData.groups.length == 0;
    private property <bool> has-recent: RemindersData.recent.length > 0;
    private property <float> recent-h: 132;

    Backdrop { dim: 0.35; }
    NavRail {
        x: 14 * root.u;
        y: 42 * root.u;
        height: (root.ch - 152) * root.u;
        u: root.u;
        current: Screen.reminders;
    }

    // Đầu màn.
    HorizontalLayout {
        x: root.left * root.u;
        y: 42 * root.u;
        width: (root.right - root.left) * root.u;
        height: 40 * root.u;
        spacing: 16 * root.u;
        Text {
            text: "Lời nhắc";
            color: Theme.text;
            font-size: Theme.type-page-title;
            font-weight: 600;
            vertical-alignment: center;
        }
        if RemindersData.title != "": Rectangle {
            width: count.preferred-width + 32 * root.u;
            border-radius: self.height / 2;
            background: Theme.glass;
            border-width: 1 * root.u;
            border-color: Theme.border;
            count := Text { text: RemindersData.title; color: Theme.text-dim; font-size: Theme.type-caption; }
        }
        Rectangle { horizontal-stretch: 1; }
    }

    // Trống: mascot + câu gợi ý.
    if root.empty: Rectangle {
        x: root.left * root.u;
        y: root.top * root.u;
        width: (root.right - root.left) * root.u;
        height: (root.bottom - root.top - (root.has-recent ? root.recent-h + 16 : 0)) * root.u;
        border-radius: Theme.radius-panel;
        background: Theme.glass;
        border-width: 1 * root.u;
        border-color: Theme.border;
        VerticalLayout {
            alignment: center;
            spacing: 12 * root.u;
            Image {
                height: min(160 * root.u, parent.height * 0.5);
                source: @image-url("../../assets/home/mascot/assistant.png");
                image-fit: contain;
            }
            Text { text: "Chưa có lời nhắc nào"; color: Theme.text; font-size: Theme.type-section; font-weight: 600; horizontal-alignment: center; }
            Text { text: "Thử nói: “Hey Jarvis, nhắc tôi uống thuốc lúc 9 giờ tối”"; color: Theme.text-dim; font-size: Theme.type-body; horizontal-alignment: center; wrap: word-wrap; }
        }
    }

    // Thẻ "Kế tiếp".
    if !root.empty: Rectangle {
        x: root.left * root.u;
        y: root.top * root.u;
        width: root.lcol * root.u;
        height: (root.bottom - root.top - (root.has-recent ? root.recent-h + 16 : 0)) * root.u;
        border-radius: Theme.radius-panel;
        background: RemindersData.has-next ? @linear-gradient(135deg, Theme.warm.darker(0.45) 0%, Theme.warm 85%) : Theme.glass;
        border-width: 1 * root.u;
        border-color: RemindersData.has-next ? Theme.warm.brighter(0.4) : Theme.border;
        drop-shadow-blur: RemindersData.has-next ? 16 * root.u : 0;
        drop-shadow-color: Theme.warm.with-alpha(0.38);
        if !RemindersData.has-next: Text {
            text: "Không còn lời nhắc nào hôm nay";
            color: Theme.text-dim;
            font-size: Theme.type-body;
        }
        if RemindersData.has-next: VerticalLayout {
            padding: 22 * root.u;
            spacing: 6 * root.u;
            alignment: center;
            HorizontalLayout {
                spacing: 8 * root.u;
                alignment: start;
                Rectangle {
                    width: 30 * root.u;
                    height: 30 * root.u;
                    border-radius: Theme.radius-s * 0.75;
                    background: Theme.text.with-alpha(0.2);
                    Image {
                        width: 18 * root.u;
                        height: 18 * root.u;
                        source: @image-url("../../assets/home/icons/sparkle.png");
                        colorize: Theme.text;
                    }
                }
                Text { text: "Kế tiếp"; color: Theme.text; font-size: Theme.type-card-title; font-weight: 600; vertical-alignment: center; }
            }
            Text { text: RemindersData.next.time; color: Theme.text; font-size: Theme.type-clock; font-weight: 300; }
            Text { text: RemindersData.next.until; color: Theme.text; font-size: Theme.type-body; font-weight: 600; }
            Text { text: RemindersData.next.text; color: Theme.text; font-size: Theme.type-section; wrap: word-wrap; overflow: elide; }
            if RemindersData.next.repeat-text != "": Text {
                text: "↻ " + RemindersData.next.repeat-text;
                color: Theme.text.with-alpha(0.8);
                font-size: Theme.type-caption;
            }
        }
    }

    // Danh sách theo nhóm ngày.
    if !root.empty: Rectangle {
        x: (root.left + root.lcol + 16) * root.u;
        y: root.top * root.u;
        width: (root.right - root.left - root.lcol - 16) * root.u;
        height: (root.bottom - root.top) * root.u;
        border-radius: Theme.radius-panel;
        background: Theme.glass;
        border-width: 1 * root.u;
        border-color: Theme.border;
        clip: true;
        Flickable {
            x: 16 * root.u;
            y: 16 * root.u;
            width: parent.width - 32 * root.u;
            height: parent.height - 32 * root.u;
            content-height: tl.preferred-height;
            tl := VerticalLayout {
                spacing: 8 * root.u;
                if RemindersData.groups.length == 0: Text { text: "Không có lời nhắc sắp tới"; color: Theme.text-dim; font-size: Theme.type-body; }
                for g in RemindersData.groups: VerticalLayout {
                    spacing: 8 * root.u;
                    padding-bottom: 6 * root.u;
                    Text { text: g.label; color: Theme.text; font-size: Theme.type-card-title; font-weight: 600; }
                    for it in g.items: ItemRow { item: it; }
                }
            }
        }
    }

    // Đã nhắc gần đây: dưới thẻ Kế tiếp (hoặc dưới khung trống).
    if root.has-recent: Rectangle {
        x: root.left * root.u;
        y: (root.bottom - root.recent-h) * root.u;
        width: (root.empty ? root.right - root.left : root.lcol) * root.u;
        height: root.recent-h * root.u;
        border-radius: Theme.radius-panel;
        background: Theme.glass;
        border-width: 1 * root.u;
        border-color: Theme.border;
        clip: true;
        VerticalLayout {
            padding: 14 * root.u;
            spacing: 8 * root.u;
            Text { text: "Đã nhắc gần đây"; color: Theme.text; font-size: Theme.type-card-title; font-weight: 600; }
            HorizontalLayout {
                spacing: 8 * root.u;
                for p in RemindersData.recent: PastCard { past: p; }
            }
        }
    }
}
