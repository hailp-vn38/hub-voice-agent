import { Theme } from "../theme.slint";
import { Screen } from "../contract/nav.slint";
import { WeatherData } from "../contract/weather.slint";
import { WeatherBackdrop } from "../components/weather/backdrop.slint";
import { NavRail } from "../components/home/nav-rail.slint";
import { CurrentColumn } from "../components/weather/current.slint";
import { HoursChart } from "../components/weather/hours-chart.slint";
import { DaysColumn } from "../components/weather/days-column.slint";

// Màn Thời tiết (Aurora): nền động theo thời tiết phủ lớp tối; Thanh điều hướng trái;
// ba thẻ kính: hiện tại, biểu đồ 24 giờ, 7 ngày. Toạ độ theo canvas 1280×600 nhân Theme.unit.
export component Weather inherits Rectangle {
    private property <length> u: Theme.unit;
    private property <float> cw: self.width / root.u;
    private property <float> ch: self.height / root.u;
    private property <float> left: 130;
    private property <float> right: root.cw - 30;
    private property <float> top: 96;
    private property <float> bottom: root.ch - 92;
    private property <float> cur-w: 280;
    private property <float> days-w: 330;
    private property <int> serial: WeatherData.focus-serial;
    private property <bool> lit: false;
    changed serial => { root.lit = true; }
    Timer { interval: 2500ms; running: root.lit; triggered => { root.lit = false; } }

    WeatherBackdrop { bg: WeatherData.background; is-day: WeatherData.is-day; }
    Rectangle { background: @linear-gradient(180deg, Theme.background.with-alpha(0.55) 0%, Theme.background.with-alpha(0.3) 50%, Theme.background.with-alpha(0.85) 100%); }
    NavRail {
        x: 14 * root.u;
        y: 42 * root.u;
        height: (root.ch - 152) * root.u;
        u: root.u;
        current: Screen.weather;
    }

    // Đầu màn: tiêu đề + nơi, nhãn "tạm xem", trạng thái cập nhật (chấm + chữ).
    HorizontalLayout {
        x: root.left * root.u;
        y: 42 * root.u;
        width: (root.right - root.left) * root.u;
        height: 40 * root.u;
        spacing: 16 * root.u;
        Text { text: "Thời tiết"; color: Theme.text; font-size: Theme.type-page-title; font-weight: 600; vertical-alignment: center; }
        Text { text: WeatherData.location; color: Theme.text-dim; font-size: Theme.type-card-title; vertical-alignment: center; overflow: elide; }
        if WeatherData.preview: Rectangle {
            width: pv.preferred-width + 32 * root.u;
            border-radius: self.height / 2;
            background: Theme.accent.with-alpha(0.55);
            border-width: 1 * root.u;
            border-color: Theme.accent;
            pv := Text { text: "Tạm xem"; color: Theme.text; font-size: Theme.type-caption; font-weight: 600; }
        }
        Rectangle { horizontal-stretch: 1; }
        Rectangle {
            width: st.preferred-width + 44 * root.u;
            border-radius: self.height / 2;
            background: WeatherData.stale ? Theme.warm.with-alpha(0.18) : Theme.glass;
            border-width: 1 * root.u;
            border-color: WeatherData.stale ? Theme.warm : Theme.border;
            Rectangle {
                x: 16 * root.u;
                width: 8 * root.u;
                height: self.width;
                border-radius: self.width / 2;
                background: WeatherData.stale ? Theme.warm : Theme.done;
            }
            st := Text {
                x: 32 * root.u;
                text: (WeatherData.stale ? "Offline · " : "") + "Cập nhật " + WeatherData.updated;
                color: WeatherData.stale ? Theme.warm : Theme.text-dim;
                font-size: Theme.type-caption;
                vertical-alignment: center;
            }
        }
    }

    CurrentColumn {
        x: root.left * root.u;
        y: root.top * root.u;
        width: root.cur-w * root.u;
        height: (root.bottom - root.top) * root.u;
        now: WeatherData.now;
        aqi-lit: root.lit && WeatherData.focus == "aqi";
    }

    Rectangle {
        x: (root.left + root.cur-w + 16) * root.u;
        y: root.top * root.u;
        width: (root.right - root.left - root.cur-w - root.days-w - 32) * root.u;
        height: (root.bottom - root.top) * root.u;
        border-radius: Theme.radius-panel;
        background: Theme.glass;
        border-width: 1 * root.u;
        border-color: Theme.border;
        clip: true;
        Text {
            x: 18 * root.u;
            y: 14 * root.u;
            text: "24 giờ";
            color: Theme.text;
            font-size: Theme.type-card-title;
            font-weight: 600;
        }
        for d in WeatherData.days: Rectangle { if d.key == WeatherData.selected-day: HoursChart {
            x: 14 * root.u;
            y: 30 * root.u;
            width: parent.width - 28 * root.u;
            height: parent.height - 36 * root.u;
            hours: WeatherData.hours;
            lo: WeatherData.week-min; hi: WeatherData.week-max;
            focus-key: WeatherData.focus;
            lit: root.lit;
        } }
    }

    DaysColumn {
        x: (root.right - root.days-w) * root.u;
        y: root.top * root.u;
        width: root.days-w * root.u;
        height: (root.bottom - root.top) * root.u;
        days: WeatherData.days;
        week-min: WeatherData.week-min; week-max: WeatherData.week-max;
        selected: WeatherData.selected-day; focus-key: WeatherData.focus; lit: root.lit;
        pick(k) => { WeatherData.select-day(k); }
    }
}
