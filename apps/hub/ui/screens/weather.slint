import { Theme } from "../theme.slint";
import { Nav } from "../contract/nav.slint";
import { BackNav } from "../components/back-nav.slint";
import { WeatherData } from "../contract/weather.slint";
import { WeatherBackdrop } from "../components/weather/backdrop.slint";
import { CurrentColumn } from "../components/weather/current.slint";
import { HoursChart } from "../components/weather/hours-chart.slint";
import { DaysColumn } from "../components/weather/days-column.slint";

export component Weather inherits Rectangle {
    private property <int> serial: WeatherData.focus-serial;
    private property <bool> lit: false;
    changed serial => { root.lit = true; }
    Timer { interval: 2500ms; running: root.lit; triggered => { root.lit = false; } }

    WeatherBackdrop { bg: WeatherData.background; is-day: WeatherData.is-day; }
    VerticalLayout {
        padding: Theme.space-l;
        spacing: Theme.space-m;
        Rectangle {
            height: Theme.touch-min;
            HorizontalLayout {
                spacing: Theme.space-m;
                Text { text: "‹ Thời tiết · " + WeatherData.location; color: Theme.text; font-size: Theme.font-title; vertical-alignment: center; }
                if WeatherData.preview: Rectangle {
                    width: 160px * Theme.text-scale; height: 48px; y: (parent.height - 48px) / 2;
                    background: Theme.accent; border-radius: 24px;
                    Text { text: "tạm xem"; color: Theme.background; font-size: Theme.font-small; horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle { horizontal-stretch: 1; }
                if WeatherData.stale: Rectangle {
                    width: 140px * Theme.text-scale; height: 48px; y: (parent.height - 48px) / 2;
                    background: Theme.error; border-radius: 24px;
                    Text { text: "offline"; color: Theme.background; font-size: Theme.font-small; horizontal-alignment: center; vertical-alignment: center; }
                }
                Text { text: "Cập nhật " + WeatherData.updated; color: Theme.text-dim; font-size: Theme.font-small; vertical-alignment: center; }
            }
            TouchArea { width: 420px; x: 0; clicked => { Nav.navigate(BackNav.origin); } }
        }
        HorizontalLayout {
            spacing: Theme.space-m;
            vertical-stretch: 1;
            CurrentColumn { width: 520px; now: WeatherData.now; aqi-lit: root.lit && WeatherData.focus == "aqi"; }
            Rectangle {
                horizontal-stretch: 1;
                background: #00000040; border-radius: Theme.radius; clip: true;
                for d in WeatherData.days: Rectangle { if d.key == WeatherData.selected-day: HoursChart {
                    x: Theme.space-m; width: parent.width - 2 * Theme.space-m; height: parent.height;
                    hours: WeatherData.hours;
                    lo: WeatherData.week-min; hi: WeatherData.week-max;
                    focus-key: WeatherData.focus;
                    lit: root.lit;
                } }
            }
            DaysColumn {
                width: 560px;
                days: WeatherData.days;
                week-min: WeatherData.week-min; week-max: WeatherData.week-max;
                selected: WeatherData.selected-day; focus-key: WeatherData.focus; lit: root.lit;
                pick(k) => { WeatherData.select-day(k); }
            }
        }
        Rectangle { height: 240px; } // chừa Voice dock
    }
}
