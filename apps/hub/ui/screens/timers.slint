import { Theme } from "../theme.slint";
import { Nav } from "../contract/nav.slint";
import { BackNav } from "../components/back-nav.slint";
import { TimersData } from "../contract/timers.slint";
import { SpawnIn } from "../components/spawn.slint";
import { TimerCardView } from "../components/timer-card.slint";
import { TimerRing } from "../components/timer-ring.slint";
import { Dock } from "../components/orb.slint";

// 1 thẻ: một vòng lớn giữa màn; 2: hai cột; 3-4: lưới 2x2.
export component Timers inherits Rectangle {
    private property <int> n: TimersData.timers.length;
    private property <int> cols: root.n <= 2 ? max(root.n, 1) : 2;
    private property <int> rows: root.n <= 2 ? 1 : ceil(root.n / 2);
    private property <length> gap: Theme.space-m;
    private property <length> cw: (area.width - (root.cols - 1) * root.gap) / root.cols;
    private property <length> ch: (area.height - (root.rows - 1) * root.gap) / root.rows;

    VerticalLayout {
        padding: Theme.space-l;
        spacing: Theme.space-m;
        Rectangle {
            height: Theme.touch-min;
            Text {
                text: TimersData.title;
                color: Theme.text;
                font-size: Theme.font-title;
                horizontal-alignment: left;
                vertical-alignment: center;
            }
            TouchArea { width: 480px; x: 0; clicked => { Nav.navigate(BackNav.origin); } }
        }
        area := Rectangle {
            vertical-stretch: 1;
            if root.n == 0: TimerRing {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height - 80px) / 2;
                width: self.height;
                height: min(parent.height - 120px, 360px);
                progress: 0;
            }
            if root.n == 0: Text {
                y: parent.height - self.height - 16px;
                width: parent.width;
                text: "Hey Jarvis, hẹn giờ 5 phút";
                color: Theme.text-dim;
                font-size: Theme.font-body;
                horizontal-alignment: center;
            }
            for t[i] in TimersData.timers: SpawnIn {
                key: t.key;
                x: mod(i, root.cols) * (root.cw + root.gap);
                y: floor(i / root.cols) * (root.ch + root.gap);
                width: root.cw;
                height: root.ch;
                animate x, y, width, height { duration: Theme.anim-screen; easing: ease-out; }
                TimerCardView {
                    timer: t;
                    focused: TimersData.focus == t.key;
                    focus-serial: TimersData.focus-serial;
                    toggle-pause => { TimersData.toggle-pause(t.key); }
                    add-minute => { TimersData.add-minute(t.key); }
                    cancel => { TimersData.cancel(t.key); }
                }
            }
        }
        HorizontalLayout {
            height: Theme.touch-min;
            spacing: Theme.space-s;
            for m in [1, 3, 5, 10, 15]: Rectangle {
                background: Theme.card;
                border-radius: Theme.radius;
                Text { text: m + " phút"; color: Theme.text; font-size: Theme.font-small; }
                TouchArea { clicked => { TimersData.quick-start(m); } }
            }
        }
        Rectangle { height: Dock.height; } // chừa Voice dock
    }
}
