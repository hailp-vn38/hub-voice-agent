import { Button, LineEdit, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";

export component VoiceSettings inherits Rectangle {
    in-out property <string> ota-url;
    in property <string> device-id;
    in property <string> status;
    in property <string> activation;
    in property <string> error;
    in property <bool> enrolling;
    callback save(string);
    callback connect();
    callback back();

    background: Theme.background;
    VerticalBox {
        padding: 48px;
        spacing: 18px;
        Text { text: "Settings · Kết nối voice"; color: Theme.text; font-size: Theme.font-title; }
        Text { text: "OTA URL"; color: Theme.text; font-size: Theme.font-small; }
        HorizontalBox {
            spacing: 12px;
            LineEdit { text <=> root.ota-url; placeholder-text: "http://<server>/voice/ota"; }
            Button { text: "Lưu"; clicked => { root.save(root.ota-url); } }
        }
        if root.error != "": Text { text: root.error; color: Theme.error; font-size: Theme.font-small; wrap: word-wrap; }
        Text { text: "Device ID: " + root.device-id; color: Theme.text; font-size: Theme.font-small; }
        Text { text: "Trạng thái: " + root.status; color: Theme.text; font-size: Theme.font-small; }
        if root.enrolling: VerticalBox {
            spacing: 12px;
            Text { text: root.activation; color: Theme.accent; font-size: Theme.font-title; }
            Text { text: "Nhập mã này trong mục Thêm thiết bị trên admin web, rồi bấm Kết nối"; color: Theme.text; font-size: Theme.font-small; wrap: word-wrap; }
            Button { text: "Kết nối"; clicked => { root.connect(); } }
        }
        Rectangle { vertical-stretch: 1; }
        Button { text: "Quay lại"; clicked => { root.back(); } }
    }
}
