import { Theme } from "../theme.slint";
import { ActionButton } from "../components/action-button.slint";

// Thẻ xác nhận dùng chung: tiêu đề, nội dung, "Huỷ" / nút hành động.
export component Confirm inherits Rectangle {
    in property <string> title;
    in property <string> body;
    in property <string> action-text: "Đồng ý";
    in property <bool> danger: true;
    callback confirmed();
    callback cancelled();
    background: #000000a0;
    TouchArea { }
    Rectangle {
        width: 760px;
        height: 300px;
        border-radius: Theme.radius;
        background: Theme.card;
        VerticalLayout {
            padding: Theme.space-l;
            spacing: Theme.space-m;
            Text { text: root.title; color: Theme.text; font-size: Theme.font-title; horizontal-alignment: center; }
            if root.body != "": Text { text: root.body; color: Theme.text-dim; font-size: Theme.font-small; horizontal-alignment: center; wrap: word-wrap; }
            HorizontalLayout {
                spacing: Theme.space-m;
                ActionButton { text: "Huỷ"; clicked => { root.cancelled(); } }
                ActionButton { text: root.action-text; danger: root.danger; clicked => { root.confirmed(); } }
            }
        }
    }
}
