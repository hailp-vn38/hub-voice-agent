import { Theme } from "../theme.slint";
import { AlertData, AlertKind } from "../contract/alert.slint";
import { Icon } from "../components/icon.slint";
import { Backdrop } from "../components/home/backdrop.slint";

// Báo toàn màn (hết giờ / Reminder). Chạm bất kỳ đâu để tắt; chừa hàng dock cho Orb.
// Khi đóng: hẹn giờ mờ đi; Reminder thu nhỏ về góc trái dưới ("Đã nhắc gần đây").
export component Alert inherits Rectangle {
    in property <length> dock-height: 240px;
    private property <AlertKind> kind: AlertData.kind;
    private property <bool> on: root.kind != AlertKind.none;
    // Loại báo đang (hoặc vừa) hiện, giữ lại để vẽ trong lúc mờ dần.
    private property <AlertKind> last: AlertKind.timer;
    changed kind => { if (root.kind != AlertKind.none) { root.last = root.kind; } }
    private property <bool> is-timer: root.last == AlertKind.timer;
    private property <float> vis: root.on ? 1 : 0;
    animate vis { duration: root.on ? 300ms : 450ms; easing: ease-out; }
    // 0 khi đang hiện, 1 khi Reminder đã thu hẳn về góc.
    private property <float> shrink: !root.on && !root.is-timer ? 1 - root.vis : 0;
    private property <color> tone: root.is-timer ? Theme.warm : Theme.accent;
    private property <length> u: Theme.unit;
    private property <duration> now: animation-tick();
    private property <duration> t0: -10000ms;
    private property <int> serial: AlertData.serial;
    changed serial => { root.t0 = animation-tick(); }
    // Nhịp chuông 1,2 s; 0..1 trong mỗi nhịp.
    private property <float> beat: Math.mod((root.now - root.t0) / 1200ms, 1);
    private property <float> enter: clamp((root.now - root.t0) / 500ms, 0, 1);

    opacity: root.vis;

    if root.on: TouchArea { clicked => { AlertData.dismiss(); } }

    if root.vis > 0: Backdrop { dim: 0.35; }
    if root.vis > 0: Rectangle { background: root.tone.with-alpha(0.08); }

    if root.vis > 0: Rectangle {
        x: -root.shrink * parent.width * 0.4;
        y: root.shrink * (parent.height - root.dock-height) * 0.4;
        height: parent.height - root.dock-height;
        transform-scale: 1 - 0.8 * root.shrink;
        // Thẻ kính Aurora, viền và bóng theo tông báo.
        Rectangle {
            width: min(460 * root.u, parent.width - 40 * root.u);
            height: min(320 * root.u, parent.height - 24 * root.u);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-panel;
            background: root.is-timer ? Theme.warm.with-alpha(0.2) : Theme.glass;
            border-width: 1 * root.u;
            border-color: root.tone;
            drop-shadow-blur: 24 * root.u;
            drop-shadow-color: root.tone.with-alpha(0.38);
            VerticalLayout {
                alignment: center;
                spacing: 10 * root.u;
                // Chuông trong vòng lan theo nhịp.
                Rectangle {
                    height: 112 * root.u;
                    Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 96 * root.u;
                        height: self.width;
                        border-radius: self.width / 2;
                        border-width: 4 * root.u;
                        border-color: root.tone;
                        opacity: 1 - root.beat;
                        transform-scale: 1 + root.beat * 0.5;
                    }
                    Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 96 * root.u;
                        height: self.width;
                        border-radius: self.width / 2;
                        background: Theme.card.with-alpha(0.6);
                        border-width: 1 * root.u;
                        border-color: Theme.border;
                    }
                    Icon {
                        x: (parent.width - self.width) / 2 - sin(root.beat * 2turn) * 4 * root.u;
                        y: (parent.height - self.height) / 2;
                        name: "bell";
                        size: 44 * root.u;
                        color: root.tone;
                    }
                }
                Text {
                    text: root.is-timer ? AlertData.title : AlertData.time;
                    color: Theme.text;
                    font-size: root.is-timer ? Theme.type-page-title : Theme.type-clock * 0.6;
                    font-weight: root.is-timer ? 600 : 300;
                    horizontal-alignment: center;
                }
                // Hẹn giờ: tên + "hết giờ"; Reminder: nội dung chạy ra từ Orb.
                Text {
                    text: AlertData.body;
                    visible: !root.is-timer;
                    opacity: root.enter;
                    color: Theme.text;
                    font-size: Theme.type-section;
                    font-weight: 600;
                    horizontal-alignment: center;
                    overflow: elide;
                }
                Text {
                    text: root.is-timer ? "Hết giờ" : "";
                    visible: root.is-timer;
                    color: Theme.warm;
                    font-size: Theme.type-section;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Chạm để tắt";
                    color: Theme.text-dim;
                    font-size: Theme.type-caption;
                    horizontal-alignment: center;
                }
            }
        }
    }
}
